# Created for you by `python issuer_service/setup_keys.py` (do not commit backend/.env).
# One variable per issuer in backend/config/issuers.json, named by its api_key_env field.
ISSUER_KEY_REVENUE_DEPT=pk_generated_by_setup_keys
# Only if an issuer is reached over plain HTTP on a private network (never for the public internet):
# PRAMANIK_ALLOW_INSECURE_HTTP=1
# Secret that keys the reuse ledger's fingerprints (also created by setup_keys.py). Without it the reuse
# check is switched off. Changing it later makes the ledger forget what it has seen.
PRAMANIK_FINGERPRINT_KEY=generated_by_setup_keys
# Reuse ledger database. Default is a local SQLite file at backend/data/pramanik.db.
# For PostgreSQL also `pip install psycopg2-binary`:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pramanik
# Only if Tesseract is installed somewhere unusual (otherwise it is found on PATH):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
