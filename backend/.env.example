# Created for you by `python issuer_service/setup_keys.py` (do not commit backend/.env).
# One variable per issuer in backend/config/issuers.json, named by its api_key_env field.
ISSUER_KEY_REVENUE_DEPT=pk_generated_by_setup_keys
# Only if an issuer is reached over plain HTTP on a private network (never for the public internet):
# PRAMANIK_ALLOW_INSECURE_HTTP=1
# Secret that keys the reuse ledger's fingerprints (also created by setup_keys.py). Without it the reuse
# check is switched off. Changing it later makes the ledger forget what it has seen.
PRAMANIK_FINGERPRINT_KEY=generated_by_setup_keys
# Reuse ledger database. Default is a local SQLite file at backend/data/pramanik.db.
# For PostgreSQL also `pip install psycopg2-binary`:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pramanik
# Only if Tesseract is installed somewhere unusual (otherwise it is found on PATH):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Only if the front end runs on another address (e.g. a Vite dev server). Comma-separated; "*" is ignored on purpose.
# PRAMANIK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# --- sign-in --------------------------------------------------------------------------------------------
# Who may create an account. Unset = anyone (fine for a demo, prints a warning). For a real deployment set a code
# that you hand to people, or PRAMANIK_SIGNUP=closed and add accounts with `python backend/tools/create_user.py`.
# PRAMANIK_SIGNUP_CODE=choose-a-long-random-string
# PRAMANIK_SIGNUP=closed
# Hours a login lasts (default 8).
# PRAMANIK_SESSION_HOURS=8
# Mark the session cookie Secure. "auto" (default) does so when the request arrives over HTTPS (or behind a proxy that
# sends X-Forwarded-Proto: https). Use 1 to always do it.
# PRAMANIK_COOKIE_SECURE=auto
# --- hosting ---------------------------------------------------------------------------------------------
# Public demo: make sample documents on this server and offer them (signed-in users only) at /demo. Off by default.
# PRAMANIK_DEMO=1
# How many photos are read at the same time. Each one needs memory (about 250 MB for a large phone photo); keep it at 1
# on a small server.
# PRAMANIK_MAX_SCANS=1
# Hosting platforms set PORT; run_all.py then serves Pramanik on it (default 8001).
# Largest image side (pixels) kept in memory when a photo is read; default 3000. Lower it on a small server (2000 keeps
# a 12 MP photo near 380 MB in total). Reading accuracy was unchanged at 2000.
# PRAMANIK_MAX_IMAGE_SIDE=2000
