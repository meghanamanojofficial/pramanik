          "All printed fields match the issuer record."
        ],
        "fields": [
          {
            "field": "certificate_number",
            "document": "INC-2026-0412",
            "issuer": "INC-2026-0412",
            "match": true
          },
          {
            "field": "holder_name",
            "document": "Ravi Kumar",
            "issuer": "Ravi Kumar",
            "match": true
          },
          {
            "field": "issue_date",
            "document": "2026-03-01",
