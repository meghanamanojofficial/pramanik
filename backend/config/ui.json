{
  "app_title": "Document verification",
  "subtitle": "Check a document against the issuer's record. Supported: {document_types}.",
  "default_officer_id": "",
  "officer_id_label": "Officer ID (self-reported, not verified)",
  "max_upload_mb": 10,
  "purposes": [
    "Benefit application",
    "Eligibility check",
    "Records audit"
  ],
  "verdict_labels": {
    "VERIFIED": "Verified",
    "MISMATCH": "Does not match issuer record",
    "SUSPICIOUS": "Suspicious",
    "UNVERIFIABLE": "Unverifiable"
  },
  "messages": {
    "case_id_required": "A case or application ID is required.",
    "not_pdf": "Upload a text-based PDF.",
    "file_too_large": "File is larger than {max_mb} MB.",
    "request_unreadable": "The request could not be read.",
    "verification_failed": "Verification could not be completed.",
    "doc_type_unrecognised": "Document type not recognised.",
    "field_unreadable": "Could not read {field} from the document.",
    "qr_mismatch": "QR code number differs from the printed certificate number.",
    "not_found": "Issuer has no record of this certificate number.",
    "field_mismatch": "{field} on the document does not match the issuer record.",
    "status_not_valid": "Issuer lists this certificate as {status}.",
    "all_match": "All printed fields match the issuer record.",
    "unreachable": "Issuer could not be reached.",
    "unconnected": "No issuer is connected for this document type.",
    "not_configured": "No API key is configured for this issuer. Run issuer_service/setup_keys.py.",
    "key_rejected": "The issuer rejected Pramanik's API key (or the key is not allowed for this issuer).",
    "rate_limited": "The issuer is limiting requests. Try again shortly.",
    "registry_unavailable": "The issuer is reachable but its registry could not be read.",
    "bad_response": "The issuer sent a response Pramanik could not read.",
    "insecure_transport": "The issuer address uses plain HTTP. Use HTTPS (plain HTTP is only allowed for localhost).",
    "http_error": "The issuer returned an unexpected error ({detail})."
  },
  "samples": [
    {
